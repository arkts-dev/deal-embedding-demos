import * as data from "embedding/policy-data";
import * as json from "std/json";
import * as math from "std/math";
import * as literals from "embedding/source-literals";
import * as observer from "embedding/observer";

// The existing bounded catalogue template, not a generalized workflow engine.
function quote(value: string): string { return literals.quote(value); }
function decimal(value: number): string { return literals.decimal(value); }
export async function lower(sourceName: string, selection: table): string {
    await observer.record("lower", "started", "");
    try {
        let result: string = await synthesize(sourceName, selection);
        await observer.record("lower", "completed", "");
        return result;
    } catch (error) {
        await observer.record("lower", "failed", error.code);
        throw error;
    }
}
async function synthesize(sourceName: string, selection: table): string {
    let chosen: table = selection.answers;
    let read: table = selection.read;
    let preparation: table = selection.preparation;
    let context: table = selection.context;
    let readModule: string = read.module;
    let readContract: table = read.contractFunction;
    let readFunction: string = readContract.name;
    let arguments: string[] = read.arguments;
    let prepareModule: string = preparation.module;
    let prepareContract: table = preparation.contractFunction;
    let prepareFunction: string = prepareContract.name;
    let title: string = context.requirement;
    let quantity: number = context.quantity;
    let terms: string[] = context.searchTerms;
    if (math.floor(quantity) !== quantity || quantity < 1 || quantity > 128 || terms.length < 1 || terms.length > 8) { throw { code: "CHOICE_CONTEXT", message: "Invalid catalogue context" }; }
    let deadline: string = context.until;
    let spec: string = context.specification;
    // Reserved wire field names are read through normalized string entries.
    let entries: table[] = selection.contextEntries;
    let start: string = "";
    for (let entry: table of entries) { let key: string = entry.key; if (key === "from") { start = entry.value; } }
    let condition: string = "";
    for (let term: string of terms) {
        if (condition !== "") { condition = condition + " && "; }
        let normalized: string = await data.lowercase(term);
        condition = condition + "strings.contains(search, " + quote(normalized) + ")";
    }
    let argumentSource: string = "";
    for (let argument: string of arguments) {
        if (argumentSource !== "") { argumentSource = argumentSource + ", "; }
        argumentSource = argumentSource + quote(argument);
    }
    let purposeAnswer: string = chosen.purpose; let headline: string = chosen.headline; let notice: string = chosen.notice;
    let purpose: string = "Compare"; if (purposeAnswer === "choose") { purpose = "Choose"; }
    let header: string = "Text"; if (headline === "hero") { header = "Hero"; }
    let warning: string = "";
    if (notice === "warning") { warning = "ui.Notice(text: " + quote("Check suitability: " + spec + ". Not booked.") + ", tone: \"warning\")"; }
    let source: string = "import * as catalogue from " +
        quote(readModule) +
        ";\nimport * as review from " +
        quote(prepareModule) +
        ";\nimport * as strings from \"std/string\";\nimport * as math from \"std/math\";\nimport * as values from \"ui/values\";\nexport class Row { id: string; title: string; detail: string; price: string; meta: string; available: boolean; selected: boolean; }\nexport class Load {}\nexport class Pick { value: string; }\nexport class Prepare {}\nexport class Loaded { rows: Row[] ; status: string; failed: boolean; }\nexport class Prepared { status: string; failed: boolean; }\nexport class Workspace { rows: Row[] ; status: string; selected: string; loading: boolean; failed: boolean; }\nfunction decimal(value: number): string { return values.decimal(value); }\nfunction money(cents: number): string { let whole: number = math.floor(cents / 100); let rest: number = cents - whole * 100; let pad: string = \"\"; if (rest < 10) { pad = \"0\"; } return \"€\" + decimal(whole) + \".\" + pad + decimal(rest); }\nfunction lowercase(text: string): string {\n    let out: string = \"\";\n    for (let ch: string of text) {\n        let found: boolean = false;\n        { let i: number = 0; while (i < 26) {  if (ch === strings.substring(\"ABCDEFGHIJKLMNOPQRSTUVWXYZ\", i, i + 1)) { out = out + strings.substring(\"abcdefghijklmnopqrstuvwxyz\", i, i + 1); found = true; }  i = i + 1; } }\n        if (!found) { out = out + ch; }\n    }\n    return out;\n}\nexport function initialState(): Workspace { return {rows: [], status: \"Find available equipment for your requirement.\", selected: \"\", loading: false, failed: false}; }\n// @ui-update\nexport function load(state: Workspace, action: Load): Workspace { return { rows: state.rows, status: \"Loading equipment…\", selected: \"\", loading: true ,failed: false}; }\n// @ui-effect\nexport async function fetch(state: Workspace, action: Load): Loaded {\n    try {\n        let records: table[] = await catalogue." +
        readFunction +
        "(" +
        argumentSource +
        ");\n        let rows: Row[] = [];\n        for (let record: table of records) {\n            let id: string = record.id; let name: string = record.name; let specification: string = record.specification;\n            let cents: number = record.cents; let available: number = record.available;\n            let search: string = lowercase(name + \" \" + specification);\n            if (" +
        condition +
        ") {\n                if (cents < 0 || cents > " +
        decimal(math.floor(2147483647 / quantity)) +
        " || available < 0) { throw { code: \"BAD_CATALOGUE\", message: \"Invalid price or availability\" }; }\n                let cost: number = cents * " +
        decimal(quantity) +
        ";\n                rows[rows.length] = { id: id, title: name, detail: specification, price: money(cost), meta: decimal(available) + \" available · quantity " +
        decimal(quantity) +
        "\", available: available >= " +
        decimal(quantity) +
        " ,selected: false};\n            }\n        }\n        let status: string = \"Select an option; specification still needs your review.\";\n        if (rows.length === 0) { status = \"No matching options. The requirement remains unresolved.\"; }\n        return { rows: rows, status: status ,failed: false};\n    } catch (error) { let message: string = \"Couldn’t load equipment. Please try again.\"; if (error.code === \"PROVIDER_DENIED\" || error.code === \"DENIED\") { message = \"Allow sharing in the Rental app, then try again.\"; } return { rows: state.rows, status: message, failed: true }; }\n}\n// @ui-update\nexport function loaded(state: Workspace, action: Loaded): Workspace { return { rows: action.rows, status: action.status, failed: action.failed ,selected: \"\", loading: false}; }\n// @ui-update\nexport function pick(state: Workspace, action: Pick): Workspace {\n    let rows: Row[] = []; let selected: string = \"\";\n    for (let row: Row of state.rows) {\n        let match: boolean = row.id === action.value && row.available;\n        if (match) { selected = row.id; }\n        rows[rows.length] = { id: row.id, title: row.title, detail: row.detail, price: row.price, meta: row.meta, available: row.available, selected: match };\n    }\n    return { rows: rows, selected: selected, status: \"Check the selected specification, then prepare your selection.\" ,loading: false, failed: false};\n}\n// @ui-update\nexport function prepare(state: Workspace, action: Prepare): Workspace { return { rows: state.rows, selected: state.selected, status: \"Preparing review…\", loading: true ,failed: false}; }\n// @ui-effect\nexport async function stage(state: Workspace, action: Prepare): Prepared {\n    try {\n        for (let row: Row of state.rows) {\n            if (row.id === state.selected && row.available) {\n                let detail: string = " +
        quote("Required: " + spec + ". Period: " + start + " to " + deadline + ". ") +
        " + \"Item \" + row.id + \":" +
        decimal(quantity) +
        " · \" + row.detail;\n                let staged: table = await review." +
        prepareFunction +
        "(\"catalogue-selection\", " +
        quote(readModule) +
        ", row.title, detail, row.price, " +
        quote(deadline) +
        ");\n                let accepted: boolean = staged.staged;\n                if (!accepted) { throw { code: \"NOT_STAGED\", message: \"Native review rejected the descriptor\" }; }\n                return { status: \"Selection ready for review. Not booked.\" ,failed: false};\n            }\n        }\n        return { status: \"Choose an available option first.\", failed: true };\n    } catch (error) { return { status: \"Couldn’t prepare your selection. Please try again.\", failed: true }; }\n}\n// @ui-update\nexport function prepared(state: Workspace, action: Prepared): Workspace { return { rows: state.rows, selected: state.selected, status: action.status, failed: action.failed ,loading: false}; }\nexport function main(): null { return null; }";
    let ui: string = "import * as app from \"./" +
        sourceName +
        "\";\nimport * as ui from \"./platform.dealui-pack\";\n// @ui-root\nexport view WorkspaceView(state: app.Workspace): View {\n    ui.Column() {\n        ui." +
        header +
        "(value: " +
        quote(purpose + " " + title) +
        ")\n        ui.Text(value: " +
        quote(decimal(quantity) + " required · " + start + " to " + deadline) +
        ")\n        ui.Text(value: state.status)\n        " +
        warning +
        "\n" +
        "        When(state.loading) { ui.Progress(label: \"Getting your options ready\") }\n" +
        "        ui.Button(text: \"Load options\", enabled: !state.loading, accessibilityLabel: \"Load options\", onClick: action app.Load {})\n" +
        "        When(!state.loading) {\n" +
        "            When(state.failed) { ui.Failure(text: state.status, accessibilityLabel: \"Retry catalogue\", onRetry: action app.Load {}) }\n" +
        "            ForEach(state.rows, row: app.Row, key: row.id) {\n" +
        "                ui.Option(value: row.id, title: row.title, detail: row.detail, price: row.price, meta: row.meta, enabled: row.available, selected: row.selected, accessibilityLabel: row.title, onSelect: action app.Pick { value: payload })\n" +
        "            }\n" +
        "            When(state.selected !== \"\") { ui.Button(text: \"Prepare selection\", accessibilityLabel: \"Prepare selection\", onClick: action app.Prepare {}) }\n" +
        "        }\n" +
        "    }\n" +
        "}";
    return json.stringify({ deal: source, dealui: ui });
}
export function main(): null { return null; }
