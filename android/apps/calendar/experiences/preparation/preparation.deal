import * as host from "host/preparation-plan";
import * as strings from "std/string";
function label(value: int): string { let text: string = ""; if (value === 0) { return "0 min"; } while (value > 0) { let digit: int = value % 10; text = strings.substring("0123456789", digit, digit + 1) + text; value = value / 10; } return text + " min"; }
export class Task { id: string = ""; title: string = ""; chosen: boolean = false; minutes: int = 15; editing: boolean = false; durationLabel: string = "15 min"; }
export class State { focusId: string = ""; focusTitle: string = ""; focusMinutes: int = 15; tasks: Task[] = []; start: int = 0; travel: int = 25; buffer: int = 5; leave: int = -1; prepare: int = -1; message: string = "Choose tasks and estimate their time. Travel is an editable estimate, not live routing."; loaded: boolean = false; loading: boolean = false; }
export class Load {}
export class Loaded { tasks: Task[] = []; start: int = 0; message: string = ""; }
export class Toggle { id: string = ""; }
export class Focus { id: string = ""; }
export class Duration { value: int = 15; }
export class Travel { value: int = 25; }
export class Buffer { value: int = 5; }
export class Calculate {}
export function initialState(): State { return {}; }
// @ui-update
export function begin(state: State, action: Load): State { return {tasks:state.tasks,start:state.start,travel:state.travel,buffer:state.buffer,loaded:state.loaded,message:state.message,loading:true}; }
// @ui-effect
export async function load(state: State, action: Load): Loaded {
    try {
        let facts: table = await host.snapshot(); let tasks: table[] = facts.tasks;
        let result: Task[] = []; let suggested: string = facts.suggested;
        for (let task: table of tasks) { let id: string = task.id; let title: string = task.title; let item: Task = {id:id,title:title,chosen:id === suggested}; result[result.length] = item; }
        let start: int = facts.start;
        return {tasks:result,start:start};
    } catch (error) { return {message:"Facts changed or sharing ended. Return to Calendar before planning."}; }
}
// @ui-update
export function loaded(state: State, action: Loaded): State { let message: string = state.message; if (action.message !== "") { message = action.message; } return {tasks:action.tasks,start:action.start,loaded:action.message === "",message:message}; }
// @ui-update
export function toggle(state: State, action: Toggle): State {
    let tasks: Task[] = [];
    for (let task: Task of state.tasks) { let chosen: boolean = task.chosen; if (task.id === action.id) { chosen = !chosen; } let item: Task = {id:task.id,title:task.title,minutes:task.minutes,durationLabel:task.durationLabel,chosen:chosen}; tasks[tasks.length] = item; }
    return {tasks:tasks,start:state.start,travel:state.travel,buffer:state.buffer,loaded:true,message:state.message};
}
// @ui-update
export function focus(state: State, action: Focus): State {
    let tasks: Task[] = []; let title: string = ""; let minutes: int = 15;
    for (let task: Task of state.tasks) { let selected: boolean = task.id === action.id; if (selected) { title = task.title; minutes = task.minutes; } let item: Task = {id:task.id,title:task.title,chosen:task.chosen,minutes:task.minutes,durationLabel:task.durationLabel,editing:selected}; tasks[tasks.length] = item; }
    return {tasks:tasks,start:state.start,travel:state.travel,buffer:state.buffer,loaded:true,focusId:action.id,focusTitle:title,focusMinutes:minutes,message:state.message};
}
// @ui-update
export function duration(state: State, action: Duration): State {
    if (action.value < 1 || action.value > 240) { return state; }
    let tasks: Task[] = [];
    for (let task: Task of state.tasks) { let minutes: int = task.minutes; if (task.id === state.focusId) { minutes = action.value; } let item: Task = {id:task.id,title:task.title,chosen:task.chosen,minutes:minutes,editing:task.editing,durationLabel:label(minutes)}; tasks[tasks.length] = item; }
    return {tasks:tasks,start:state.start,travel:state.travel,buffer:state.buffer,loaded:true,focusId:state.focusId,focusTitle:state.focusTitle,focusMinutes:action.value,message:state.message};
}
// @ui-update
export function travel(state: State, action: Travel): State { if (action.value < 0 || action.value > 240) { return state; } return {tasks:state.tasks,start:state.start,travel:action.value,buffer:state.buffer,loaded:true,message:state.message}; }
// @ui-update
export function buffer(state: State, action: Buffer): State { if (action.value < 0 || action.value > 120) { return state; } return {tasks:state.tasks,start:state.start,travel:state.travel,buffer:action.value,loaded:true,message:state.message}; }
// @ui-update
export function calculate(state: State, action: Calculate): State {
    let total: int = 0;
    for (let task: Task of state.tasks) { if (task.chosen) { total = total + task.minutes; } }
    let leave: int = state.start - state.travel - state.buffer;
    let prepare: int = leave - total;
    if (prepare < 0 || leave < 0) { return {tasks:state.tasks,start:state.start,travel:state.travel,buffer:state.buffer,loaded:true,message:"Preparation starts on the previous day. Reduce the estimates or plan earlier; no changes were made."}; }
    return {tasks:state.tasks,start:state.start,travel:state.travel,buffer:state.buffer,loaded:true,leave:leave,prepare:prepare,message:"Your estimates only. Tasks remain unfinished and the appointment is unchanged."};
}
export function main(): null { return null; }
