import * as trip from "host/trip";
import * as calendar from "host/calendar";

export class DepartureState {
  departure: string = "Ready when you are";
  message: string = "Plan from your event time, simulated travel and breathing room.";
  loading: boolean = false;
  buffer: int = 5;
  distance: int = 12;
  minute: int = -1;
}
export class Calculate {}
export class AddBuffer {}
export class AddDistance {}
export class Completed { departure: string = ""; message: string = ""; minute: int = -1; }
export function initialState(): DepartureState { return {}; }

// @ui-update
export function begin(state: DepartureState, action: Calculate): DepartureState {
  return { departure: state.departure, message: "Checking your connected apps…", loading: true, buffer: state.buffer, distance: state.distance, minute: -1 };
}
// @ui-update
export function adjust(state: DepartureState, action: AddBuffer): DepartureState {
  if (state.loading || state.buffer > 1434) { return state; }
  return { departure: state.departure, message: "Extra breathing room added. Recalculate when ready.", buffer: state.buffer + 5, distance: state.distance, minute: -1 };
}
// @ui-update
export function distance(state: DepartureState, action: AddDistance): DepartureState {
  if (state.loading || state.distance > 998) { return state; }
  return { departure: state.departure, message: "Route adjusted. Recalculate when ready.", buffer: state.buffer, distance: state.distance + 2, minute: -1 };
}
// @ui-effect
export async function calculate(state: DepartureState, action: Calculate): Completed {
  try {
    if (state.distance < 1 || state.distance > 1000 || state.buffer < 0 || state.buffer > 1439) {
      return { departure: "Check your inputs", message: "Distance must be 1–1000 km and buffer 0–1439 minutes." };
    }
    let start: int = await calendar.start();
    let travel: int = await trip.estimate(state.distance);
    let minute: int = start - travel - state.buffer;
    if (minute < 0 || minute > 1439) {
      return { departure: "Earlier day required", message: "Departure falls outside the selected day. Reduce distance or buffer; no reminder prepared." };
    }
    await calendar.propose(minute);
    return { departure: "Leave at", minute: minute, message: "Includes simulated travel and your breathing room. Review before saving." };
  } catch (error) {
    return { departure: "Let’s reconnect", message: error.message };
  }
}
// @ui-update
export function complete(state: DepartureState, action: Completed): DepartureState {
  return { departure: action.departure, message: action.message, buffer: state.buffer, distance: state.distance, minute: action.minute };
}
export function main(): null { return null; }
